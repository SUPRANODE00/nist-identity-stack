import time
import jwt
import requests
import json

# --- CONFIGURATION ---
APP_ID = "YOUR_GITHUB_APP_ID"       # Replace with your numeric GitHub App ID
INSTALLATION_ID = "YOUR_INSTALLATION_ID" # Replace with your GitHub App Installation ID
PRIVATE_KEY_PATH = "airpet-app.private-key.pem"
REPO_OWNER = "SUPRANODE00"
REPO_NAME = "airpet-mesh-node-51171"
TELEMETRY_FILE = "airpet_mesh_sync.json"

def generate_jwt():
    """Generates a JWT to authenticate as the GitHub App."""
    with open(PRIVATE_KEY_PATH, "r") as key_file:
        private_key = key_file.read()
    
    now = int(time.time())
    payload = {
        # Issued at time
        "iat": now - 60,
        # JWT expiration time (10 minutes maximum)
        "exp": now + (10 * 60),
        # GitHub App's identifier
        "iss": APP_ID
    }
    
    return jwt.encode(payload, private_key, algorithm="RS256")

def get_installation_access_token():
    """Exchanges App JWT for an Installation Access Token."""
    app_jwt = generate_jwt()
    headers = {
        "Authorization": f"Bearer {app_jwt}",
        "Accept": "application/vnd.github+json"
    }
    
    url = f"https://api.github.com/app/installations/{INSTALLATION_ID}/access_tokens"
    response = requests.post(url, headers=headers)
    
    if response.status_code == 201:
        return response.json()["token"]
    else:
        raise Exception(f"Failed to get installation token: {response.status_code} - {response.text}")

def push_telemetry_to_github():
    """Commits and pushes the updated telemetry JSON to the repository."""
    token = get_installation_access_token()
    headers = {
        "Authorization": f"Bearer {token}",
        "Accept": "application/vnd.github+json"
    }
    
    # Read local telemetry file content
    with open(TELEMETRY_FILE, "r") as f:
        content = f.read()
    
    api_url = f"https://api.github.com/repos/{REPO_OWNER}/{REPO_NAME}/contents/{TELEMETRY_FILE}"
    
    # Check if file already exists to get its SHA (required for updates)
    get_res = requests.get(api_url, headers=headers)
    sha = get_res.json().get("sha") if get_res.status_code == 200 else None
    
    import base64
    encoded_content = base64.b64encode(content.encode("utf-8")).decode("utf-8")
    
    payload = {
        "message": "[AXIS TELEMETRY] Automated sync update from AirPet-51171 node",
        "content": encoded_content,
        "branch": "main"
    }
    if sha:
        payload["sha"] = sha
        
    put_res = requests.put(api_url, headers=headers, json=payload)
    
    if put_res.status_code in [200, 201]:
        print("[SUCCESS] Telemetry payload successfully synced to GitHub repository via App.")
    else:
        print(f"[ERROR] Failed to push telemetry: {put_res.status_code} - {put_res.text}")

if __name__ == "__main__":
    push_telemetry_to_github()
    
