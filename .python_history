import sys
import logging
from json import dumps
from dotenv import load_dotenv
from pymongo import MongoClient

# Load local environment configuration
load_dotenv()

class CorporateAuditFormatter(logging.Formatter):
    """Custom formatter to inject corporate EIN context securely into every log statement."""
    def format(self, record):
        record.ein = os.getenv("CORPORATE_EIN", "UNKNOWN")
        record.company = os.getenv("COMPANY_NAME", "UNKNOWN")
        return super().format(record)

# Initialize secure structured logging output
handler = logging.StreamHandler(sys.stdout)
formatter = CorporateAuditFormatter('%(asctime)s [%(levelname)s] [EIN: %(ein)s] [%(company)s] %(message)s')
handler.setFormatter(formatter)

logger = logging.getLogger("AtlasInvestigatorBot")
logger.setLevel(logging.DEBUG)
logger.addHandler(handler)

def get_atlas_collection():
    """Initializes the MongoDB client using protected environment paths."""
    uri = os.getenv("MONGO_URI")
    db_name = os.getenv("DB_NAME")
    coll_name = os.getenv("COLLECTION_NAME")
    
    if not uri or "<username>" in uri:
        raise ValueError("Invalid MONGO_URI. Configure your .env file properly.")
        
    client = MongoClient(uri)
    return client[db_name][coll_name]

def diagnose_atlas_vector_search(query_embedding: list, top_k: int = 3):
    """
    Executes a vector search pipeline using MongoDB Atlas Vector Search rules.
    Automatically wraps execution logs within the authenticated corporate audit footprint.
    """
    logger.info("Initiating secure vector retrieval loop on MongoDB Atlas target cluster.")
    
    try:
        collection = get_atlas_collection()
        index_name = os.getenv("INDEX_NAME", "vector_index")
        
        # Build the native MongoDB Atlas Vector Search pipeline stage
        pipeline = [
            {
                "$vectorSearch": {
                    "index": index_name,
                    "path": "embeddings",
                    "queryVector": query_embedding,
                    "numCandidates": top_k * 10,
                    "limit": top_k
                }
            },
            {
                "$project": {
                    "_id": 1,
                    "document_id": 1,
                    "content": 1,
                    "score": {"$meta": "vectorSearchScore"}
                }
            }
        ]
        
        logger.debug(f"Executing aggregation pipeline with parameters: {dumps({'index': index_name, 'limit': top_k})}")
        cursor = collection.aggregate(pipeline)
        results = list(cursor)
        
        if not results:
            logger.warning("Atlas Search executed successfully but returned 0 records. Check index sync status.")
            return []
            
        logger.info(f"Successfully retrieved and audited {len(results)} context blocks for document discovery.")
        return results

    except Exception as e:
        logger.error(f"Critical execution block failure encountered: {str(e)}")
        if "Authentication failed" in str(e):
            logger.warning("Remediation Hint: Check credentials in your MONGO_URI string.")
        elif "IndexNotFound" in str(e):
            logger.warning("Remediation Hint: Verify that the search index name matches the database deployment.")
        raise e

